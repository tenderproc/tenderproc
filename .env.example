# Required: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project (Settings > API in the Supabase dashboard).
# NEXT_PUBLIC_SUPABASE_URL must be the bare project URL — no /rest/v1/ suffix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) — sends the "new tenders in your sectors" digest email.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Locks down /api/cron/notify to Vercel Cron. Any long random string.
CRON_SECRET=change-me
