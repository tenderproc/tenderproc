# Required: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project (Settings > API in the Supabase dashboard).
# NEXT_PUBLIC_SUPABASE_URL must be the bare project URL — no /rest/v1/ suffix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) — sends the "new tenders in your sectors" digest email.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Locks down /api/cron/notify to Vercel Cron. Any long random string.
CRON_SECRET=change-me

# Paddle (paddle.com) — Merchant of Record for Pro/Premium subscriptions.
# API key: Paddle dashboard > Developer tools > Authentication.
# Webhook secret: set after creating a webhook pointed at
#   https://<your-domain>/api/billing/webhook (Developer tools > Notifications).
# Price IDs: Paddle dashboard > Catalog > Prices, one per paid tier — Free
# has no Paddle price at all, it's an app-side default with no subscription row.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRICE_ID_PRO=pri_...
PADDLE_PRICE_ID_PREMIUM=pri_...

# Client-side Paddle.js config (lib/paddle.ts) — powers /pricing's localized
# price preview and the Paddle Checkout overlay. These are NOT secret (only
# PADDLE_API_KEY above is) and are inlined into the browser bundle, but keep
# NEXT_PUBLIC_PADDLE_ENV in sync with PADDLE_ENV above so client and server
# always point at the same Paddle account. Price ids are the same values as
# PADDLE_PRICE_ID_PRO/PREMIUM above, just under NEXT_PUBLIC_ names — Paddle.js
# needs the price id in the browser to open checkout.
# Client-side token: Paddle dashboard > Developer tools > Authentication >
# Client-side tokens. Sandbox tokens are prefixed test_.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO=pri_...
NEXT_PUBLIC_PADDLE_PRICE_ID_PREMIUM=pri_...
# Days a past_due subscription keeps paid-tier access before being treated
# as Free — mirror whatever dunning/retry window you configure in Paddle's
# own Retain settings so the two don't disagree.
BILLING_GRACE_PERIOD_DAYS=7

# Odoo — invoice creation on successful payment (see lib/odoo/client.ts).
# Not wired to a real instance yet; unset until one exists (the client
# throws clearly rather than silently no-op-ing if these are missing).
# ODOO_URL=https://your-odoo-instance.example.com
# ODOO_DB=your-database-name
# ODOO_USERNAME=api-user@example.com
# ODOO_API_KEY=your-odoo-api-key
# Ask your accountant/Odoo admin which Odoo tax id (if any) represents
# "VAT already collected by a third-party Merchant of Record" — leaving
# this unset invoices with no Odoo-side tax applied, which is the safer
# default given Paddle already remits the VAT (see lib/odoo/client.ts).
# ODOO_MOR_TAX_ID=

# BOSA e-Notification (lib/bosa.ts) — second tender source, feeds
# /tenders/[id] for BOSA:<workspaceId> ids. No credentials are required
# for the default setup: BOSA's own frontend authenticates anonymously,
# and we replicate that public client-credentials flow automatically.
# These are optional overrides only, in case BOSA changes how the
# anonymous client is exposed.
# BOSA_BASE_URL=https://www.publicprocurement.be
# BOSA_CLIENT_ID=
# BOSA_CLIENT_SECRET=
# BOSA_AUTH_REALM=
